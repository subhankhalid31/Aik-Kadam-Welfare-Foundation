# Copy this to .env and fill in real values. Never commit the real .env file.

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# Who OTPs, notifications, and inbox replies are sent FROM. Until your
# domain is verified in Resend, leave this unset (or set it to the sandbox
# address below) — Resend ignores whatever you put here and forces
# onboarding@resend.dev until verification, and can only deliver to your
# own Resend account email in that mode.
EMAIL_FROM="Aik Kadam <onboarding@resend.dev>"
# Once your domain is verified in Resend, switch to something like:
# EMAIL_FROM="Aik Kadam <help@yourdomain.com>"

# Where contact-form and partnership-form notification emails are sent.
# Defaults to subhankhalid8787@gmail.com in code if unset — only set this
# once you have a real inbox (or forwarding) ready to receive it.
CONTACT_EMAIL=subhankhalid8787@gmail.com

# ─── Inbound email (two-way threading in the admin Inbox) ─────────────────
# Optional. Without these two, replies still send fine — they just won't
# thread automatically if the recipient replies from their own email client.
# Setup: Resend dashboard -> Inbound -> turn it on (their free auto-
# provisioned <id>.resend.app subdomain works, no DNS/domain needed for
# this part specifically) -> add a webhook pointed at
# https://yourapp.com/api/webhooks/resend-inbound, subscribed to the
# "email.received" event -> copy the webhook's signing secret below.
RESEND_WEBHOOK_SECRET=
# Whatever inbound domain/alias Resend gave you, e.g. "abc123.resend.app"
RESEND_INBOUND_DOMAIN=

# ─── Google Sign-In ─────────────────────────────────────────────────────────
# Both must be set to the SAME OAuth client ID from the Google Cloud
# Console — GOOGLE_CLIENT_ID is used server-side to verify the token Google
# hands back, VITE_GOOGLE_CLIENT_ID is the one that actually gets bundled
# into the client so the browser knows which app to sign in with. Vite only
# exposes env vars prefixed VITE_ to client code, which is why there are
# two here instead of one — setting only GOOGLE_CLIENT_ID silently disables
# the "Continue with Google" button (it just doesn't render) rather than
# erroring, so it's easy to miss if you only set one.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Cron (recurring pledge reminder emails) ───────────────────────────────
# Required for /api/cron/recurring-reminders to do anything — it 401s
# without this. Also needs an external scheduler (cron-job.org, a GitHub
# Actions scheduled workflow, your host's cron, etc.) actually calling that
# endpoint on a schedule; nothing in the app triggers it on its own.
CRON_SECRET=

# ─── Uploaded file storage ──────────────────────────────────────────────────
# Case/gallery/success-story photos and donation receipts get written to
# disk at runtime. Render (and most PaaS hosts — Railway, Heroku, Fly, etc.)
# run their web services on an EPHEMERAL filesystem by default: anything
# written while the app is running disappears on the next deploy, restart,
# or scale event. The database survives fine, so a case still "exists" —
# its photo just 404s, because the file it pointed at is gone. That's why
# photos uploaded after your last deploy vanish while older ones (from
# before the container was last rebuilt) can look fine, seemingly at
# random.
#
# Leave UPLOAD_DIR unset for local development — everything defaults to
# writing inside the project folder like it always has, no setup needed.
#
# For production, you need it pointed somewhere that actually persists.
# Simplest fix, no code changes: in Render, add a "Disk" to this web
# service (Render dashboard -> your service -> Disks -> Add Disk), mount
# it at e.g. /var/data, then set:
UPLOAD_DIR=
# e.g. UPLOAD_DIR=/var/data  (Render Disks start at ~$0.25/GB/month — 1GB
# is plenty for a while). This survives redeploys and restarts because
# it's a separate persistent volume, not part of the container image.
#
# If you outgrow a single Render instance later (e.g. need to run more
# than one server, which a local disk can't share across), the next step
# up is object storage (Cloudflare R2, AWS S3, Backblaze B2) instead of a
# disk — that's a real code change (this app doesn't have that wired up
# yet), not just an env var, so only worth it once a single disk actually
# becomes a limitation.
