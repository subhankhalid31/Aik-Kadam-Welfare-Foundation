# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/aik_kadam

# Session cookie signing secret — set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Resend API key for sending OTP emails — https://resend.com
# If left blank, OTP codes are logged to the server console instead (dev mode)
RESEND_API_KEY=
EMAIL_FROM=Aik Kadam <onboarding@resend.dev>

# Google Sign-In — create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your site's URL
# under "Authorized JavaScript origins", then paste the client ID in BOTH
# of these (the second one is what the Vite frontend bundles in — Google
# client IDs are not secret, so this is safe to expose to the browser).
# If left blank, the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Used only by npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret an external scheduler must send (as the x-cron-secret header)
# to trigger POST /api/cron/recurring-reminders. Set this to a long random
# string; the endpoint refuses every request until it's set.
CRON_SECRET=
