# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/aik_kadam

# Session cookie signing secret — set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Resend API key for sending OTP emails — https://resend.com
# If left blank, OTP codes are logged to the server console instead (dev mode)
RESEND_API_KEY=
EMAIL_FROM=Aik Kadam <onboarding@resend.dev>

# Used only by npm run create-admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Sign-In — from Google Cloud Console (APIs & Services > Credentials)
# Same Client ID goes in both places: GOOGLE_CLIENT_ID is used by the backend
# to verify tokens, VITE_GOOGLE_CLIENT_ID is used by the frontend to show the
# button. Leave both blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=129118259595-5pqh7ce5kic84sndtb9rqmjgi79mp5ob.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=129118259595-5pqh7ce5kic84sndtb9rqmjgi79mp5ob.apps.googleusercontent.com

# Shared secret an external scheduler must send (as the x-cron-secret header)
# to trigger POST /api/cron/recurring-reminders. Set this to a long random
# string; the endpoint refuses every request until it's set.
CRON_SECRET=
